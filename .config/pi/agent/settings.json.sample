{
  "theme": "dark",
  "defaultProvider": "<<<provider-id>>>",
  "defaultModel": "<<<model-id-from-list-models-not-a-tier>>>",
  "enabledModels": [
    "tier:strong",
    "tier:mid",
    "tier:fast",
    "ollama/*",
    "google-vertex/gemini-3*"
  ],
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@ctogg/pi-cost-counter",
    "npm:@narumitw/pi-lsp",
    "npm:@narumitw/pi-retry",
    "npm:pi-ask-user",
    "npm:pi-magpi",
    "npm:pi-mcporter",
    "npm:pi-rewind",
    "npm:pi-sandbox"
  ]
}
