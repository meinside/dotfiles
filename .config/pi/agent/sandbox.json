{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 300,
  "allowBrowserProcess": false,
  "network": {
    "allowLocalBinding": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowAllUnixSockets": false,
    "allowedDomains": [
      "*.crates.io",
      "*.github.com",
      "*.githubusercontent.com",
      "*.npmjs.org",
      "*.pypi.org",
      "*.rubygems.org",
      "127.0.0.1",
      "files.pythonhosted.org",
      "formulae.brew.sh",
      "localhost",
      "proxy.golang.org",
      "sum.golang.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      ".",
      "~/.cache",
      "~/.config/pi/cost-tracker",
      "~/.gem/cache",
      "~/.gem/specs",
      "~/.local/share/asdf",
      "~/.local/share/cargo/git",
      "~/.local/share/cargo/registry",
      "~/.local/share/npm",
      "~/.local/share/pipx",
      "~/.local/share/rustup",
      "~/.local/share/uv",
      "~/.pi/cost-tracker",
      "~/Library/Caches/Homebrew",
      "~/Library/Logs/Homebrew",
      "~/srcs/go"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.bundle/cache",
      "~/.cache/npm",
      "~/.cache/pip",
      "~/.cache/uv",
      "~/.config/asdf",
      "~/.config/pi/cost-tracker",
      "~/.gem/cache",
      "~/.gem/specs",
      "~/.local/share/asdf",
      "~/.local/share/cargo/git",
      "~/.local/share/cargo/registry",
      "~/.local/share/npm",
      "~/.local/share/pipx",
      "~/.local/share/rustup",
      "~/.local/share/uv",
      "~/.pi/cost-tracker",
      "~/Library/Caches/Homebrew",
      "~/Library/Logs/Homebrew",
      "~/srcs/go"
    ],
    "denyWrite": [
      "*.key",
      "*.p12",
      "*.pem",
      "*.pfx",
      ".env",
      ".env.*",
      "~/.aws",
      "~/.bundle/config",
      "~/.claude/settings.json",
      "~/.config/claude/settings.json",
      "~/.config/gcloud",
      "~/.config/gh",
      "~/.config/pi/agent/auth.json",
      "~/.config/rclone",
      "~/.gem/credentials",
      "~/.gnupg",
      "~/.local/share/cargo/credentials",
      "~/.local/share/cargo/credentials.toml",
      "~/.netrc",
      "~/.npmrc",
      "~/.ollama/id_ed25519",
      "~/.pi/agent/auth.json",
      "~/.ssh"
    ]
  }
}
