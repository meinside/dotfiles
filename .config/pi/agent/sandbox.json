{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 300,
  "allowBrowserProcess": false,
  "network": {
    "allowLocalBinding": true,
    "allowUnauthenticatedSocksProxy": false,
    "allowAllUnixSockets": false,
    "allowedDomains": [
      "*.crates.io",
      "*.github.com",
      "*.githubusercontent.com",
      "*.lua.org",
      "*.luarocks.org",
      "*.nodejs.org",
      "*.npmjs.org",
      "*.pub.dev",
      "*.pypi.org",
      "*.python.org",
      "*.ruby-lang.org",
      "*.rubygems.org",
      "*.rust-lang.org",
      "127.0.0.1",
      "crates.io",
      "dl.google.com",
      "download.clojure.org",
      "download.java.net",
      "files.pythonhosted.org",
      "formulae.brew.sh",
      "ftpmirror.gnu.org",
      "ghcr.io",
      "github.com",
      "go.dev",
      "golang.org",
      "localhost",
      "luarocks.org",
      "nim-lang.org",
      "nodejs.org",
      "proxy.golang.org",
      "pub.dev",
      "pypi.org",
      "repo1.maven.org",
      "rubygems.org",
      "sh.rustup.rs",
      "storage.googleapis.com",
      "sum.golang.org",
      "ziglang.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home",
      "/root"
    ],
    "allowRead": [
      ".",
      "/home/linuxbrew",
      "~/.asdf",
      "~/.cache",
      "~/.config/git/attributes",
      "~/.config/git/config",
      "~/.config/git/ignore",
      "~/.config/go",
      "~/.config/pi/cost-tracker",
      "~/.eclipse",
      "~/.gem/cache",
      "~/.gem/specs",
      "~/.gitconfig",
      "~/.gitignore",
      "~/.gitignore_global",
      "~/.local/bin",
      "~/.local/share/asdf",
      "~/.local/share/cargo/.global-cache",
      "~/.local/share/cargo/.package-cache",
      "~/.local/share/cargo/bin",
      "~/.local/share/cargo/config.toml",
      "~/.local/share/cargo/git",
      "~/.local/share/cargo/registry",
      "~/.local/share/npm",
      "~/.local/share/nvim/mason",
      "~/.local/share/pipx",
      "~/.local/share/rustup",
      "~/.local/share/uv",
      "~/.luarocks",
      "~/.pi/cost-tracker",
      "~/.pub-cache",
      "~/.tool-versions",
      "~/Library/Application Support/go",
      "~/Library/Caches/Homebrew",
      "~/Library/Caches/go-build",
      "~/Library/Logs/Homebrew",
      "~/bin",
      "~/srcs/flutter",
      "~/srcs/go"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "/tmp",
      "~/.asdf",
      "~/.bundle/cache",
      "~/.cache",
      "~/.config/asdf",
      "~/.config/go",
      "~/.config/pi/cost-tracker",
      "~/.eclipse",
      "~/.gem/cache",
      "~/.gem/specs",
      "~/.local/share/asdf",
      "~/.local/share/cargo/.global-cache",
      "~/.local/share/cargo/.package-cache",
      "~/.local/share/cargo/bin",
      "~/.local/share/cargo/git",
      "~/.local/share/cargo/registry",
      "~/.local/share/npm",
      "~/.local/share/pipx",
      "~/.local/share/rustup",
      "~/.local/share/uv",
      "~/.luarocks",
      "~/.pi/cost-tracker",
      "~/.pub-cache",
      "~/Library/Application Support/go",
      "~/Library/Caches/Homebrew",
      "~/Library/Caches/go-build",
      "~/Library/Logs/Homebrew",
      "~/srcs/flutter",
      "~/srcs/go"
    ],
    "denyWrite": [
      "*.key",
      "*.p12",
      "*.pem",
      "*.pfx",
      ".env",
      ".env.*",
      "~/.aws",
      "~/.bundle/config",
      "~/.claude/settings.json",
      "~/.config/claude/settings.json",
      "~/.config/gcloud",
      "~/.config/gh",
      "~/.config/pi/agent/auth.json",
      "~/.config/rclone",
      "~/.gem/credentials",
      "~/.gnupg",
      "~/.local/share/cargo/credentials",
      "~/.local/share/cargo/credentials.toml",
      "~/.netrc",
      "~/.npmrc",
      "~/.ollama/id_ed25519",
      "~/.pi/agent/auth.json",
