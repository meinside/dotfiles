# list files changed in given days
# (referenced: http://gotofritz.net/blog/howto/finding-recently-changed-files-osx-terminal/)
ls-changed-in-days () {
	if [[ $1 == <-> && -d $2 ]]; then
		echo "> listing files modified in $1 day(s): $2"

		# -exec ... + instead of xargs: GNU xargs runs `du` on cwd when nothing matches
		find "$2" -type f -mtime "-$1" -exec du -sk {} + | sort -nr
	else
		echo "* usage: $0 NUM_DAYS DIR_PATH"
		return 1
	fi
}

update-macos () {
	# macOS updates
	echo
	echo "> checking for macOS software updates..."
	softwareupdate --all --install --force

	# mac appstore
	if (( $+commands[mas] )); then
		echo
		echo "> updating Mac App Store apps..."
		mas upgrade
	fi

	# homebrew
	if (( $+commands[brew] )); then
		echo
		echo "> updating brew..."
		brew update
		brew upgrade -y

		echo
		echo "> cleaning brew..."
		brew cleanup
		brew autoremove
	else
		echo
		echo "* brew not installed"
	fi
}

update-termux () {
	pkg upgrade && \
		pkg clean && \
		pkg autoclean
}

update-linux () {
	if [ -x /usr/bin/apt-get ]; then
		sudo apt-get update && \
			sudo apt-get -y upgrade && \
			sudo apt-get -y autoremove && \
			sudo apt-get -y autoclean
	elif [ -x /usr/bin/pacman ]; then
		sudo pacman -Syu || return

		# paccache comes from the separate pacman-contrib package
		if (( $+commands[paccache] )); then
			sudo paccache -ruk0
		fi
	else
		echo
		echo "* no supported package manager (apt-get, pacman) found"
	fi
}

# pull this repository, then update OS packages, go packages, pipx packages,
# neovim plugins, oh-my-zsh, and asdf plugins
# (--clean: also clean go module/build caches)
update-all () {
	local clean=false
	local arg
	for arg in "$@"; do
		case "$arg" in
			--clean) clean=true ;;
			*)
				echo "* usage: $0 [--clean]"
				return 1
				;;
		esac
	done

	# pull this repository first, so the steps below use its latest
	# ~/.gogets, asdf tool-versions, etc. (only when on master, fast-forward only)
	local branch
	if ! (( $+commands[git] )); then
		echo
		echo "* git not installed, skipped pulling ~"
	elif ! git -C ~ rev-parse --git-dir &>/dev/null; then
		echo
		echo "* ~ is not a git repository, skipped pulling ~"
	elif branch=$(git -C ~ symbolic-ref --short -q HEAD); [[ $branch == master ]]; then
		echo
		echo "> pulling ~..."
		git -C ~ pull --ff-only origin master
	else
		echo
		echo "* not on master (${branch:-detached HEAD}), skipped pulling ~"
	fi

	case "$OSTYPE" in
		darwin*) update-macos ;;
		linux-android) update-termux ;;
		linux*) update-linux ;;
	esac

	# update go packages (and clean module caches with --clean)
	if (( $+commands[goget] )); then
		echo
		echo "> updating go packages..."
		goget

		if [[ $clean == true ]]; then
			echo
			echo "> cleaning go module caches..."
			go clean -modcache

			echo
			echo "> cleaning go caches..."
			go clean -cache
		fi
	fi

	# upgrade pipx packages
	if (( $+commands[pipx] )); then
		echo
		echo "> upgrading pipx packages..."
		pipx upgrade-all
	fi

	# update neovim plugins (only when lazy.nvim is installed)
	if (( $+commands[nvim] )) && [[ -d ${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy ]]; then
		echo
		echo "> updating neovim plugins..."
		nvim --headless '+Lazy! sync' +qa
	fi

	# upgrade oh-my-zsh (`omz` is a shell function, not a command)
	if (( $+functions[omz] )); then
		echo
		echo "> upgrading oh-my-zsh..."
		omz update
	fi

	# update asdf plugins
	# (not checking $ASDF_DIR: unused since asdf v0.16, and "$ASDF_DIR/bin" becomes /bin when empty)
	if (( $+commands[asdf] )); then
		#asdf update # NOTE: does not work since v0.16.0 of asdf-vm

		echo
		echo "> updating asdf plugins..."
		asdf plugin update --all
		asdf reshim

		# list ones whose latest version is not installed
		# (`asdf latest --all` prints: NAME<TAB>VERSION<TAB>installed|missing)
		echo
		echo "> checking outdated asdf tools..."
		local outdated
		outdated=$(asdf latest --all | awk '$3 == "missing"')
		if [[ -n $outdated ]]; then
			echo "$outdated"
		else
			echo "(all up to date)"
		fi
	fi
}

# list go imports
list-go-imports () {
	if [[ $1 == '--all' ]]; then
		# show all (including standard packages)
		go list -f '{{join .Deps "\n"}}' | xargs go list -f '{{.ImportPath}}'
	else
		# not including standard
		go list -f '{{join .Deps "\n"}}' | xargs go list -f '{{if not .Standard}}{{.ImportPath}}{{end}}'
	fi
}

